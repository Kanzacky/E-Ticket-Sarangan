# ── Local development ────────────────────────────────────────────
# Backend lokal (php artisan serve):
VITE_APP_NAME="e-Ticket Sarangan"
VITE_API_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LOCALE=id

# ── Production (Vercel) ──────────────────────────────────────────
# Frontend ini adalah Vue 3 + Vite (BUKAN Next.js), jadi prefix env
# yang dipakai adalah VITE_ (bukan NEXT_PUBLIC_). Vite mengekspos
# semua variabel berawalan VITE_ ke browser saat build.
#
# Salin nilai production ke file `.env.production` ATAU set di
# Vercel Dashboard > Project (frontend) > Environment Variables.
#
# VITE_API_URL=https://e-ticket-sarangan-backend.vercel.app/api/v1
#
# Catatan: suffix `/api/v1` WAJIB karena seluruh endpoint frontend
# (mis. GET /health -> /api/v1/health, POST /auth/register) relatif
# terhadap base URL tersebut.